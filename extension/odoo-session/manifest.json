{
  "manifest_version": 3,
  "name": "goo odoo session bridge",
  "version": "1.0",
  "description": "Sends goo (127.0.0.1:8068) your odoo.com session cookie, so it can show task stages without an API key.",
  "key": "",
  "permissions": ["cookies", "alarms"],
  "host_permissions": ["https://*.odoo.com/*", "http://127.0.0.1:8068/*"],
  "background": {
    "service_worker": "background.js"
  }
}
